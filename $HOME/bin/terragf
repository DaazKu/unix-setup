#!/usr/bin/env bash
set -Eeuo pipefail

if [[ -f "$PWD/.terragf.pre-hook.sh" ]]; then
    source "$PWD/.terragf.pre-hook.sh" "$@"
fi

if [[ -f "$PWD/terragrunt.hcl" ]]; then

    # Trick Terragrunt by updating the timestamp of any symlinks in the current dir
    # This forces the cache to pull the latest version of the target file.  
    (
      cd $(git rev-parse --show-toplevel || echo ".")
      find . -name '*.tf' -type l -exec touch -h {} +
    )

    TG_TF_FORWARD_STDOUT=true TG_LOG_LEVEL=error terragrunt "$@"
else
    terraform "$@"
fi

if [[ -f "$PWD/.terragf.post-hook.sh" ]]; then
    source "$PWD/.terragf.post-hook.sh" "$@"
fi
